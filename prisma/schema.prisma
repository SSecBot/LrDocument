datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String
  role             String              @default("USER") // "USER" | "ADMIN"
  status           String              @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  subscriptionType String              @default("AYLIK") // "AYLIK" | "TEK_SEFERLIK"
  subscriptionPlan String              @default("Aylık") // "Aylık" | "Tek Seferlik"
  paymentStatus    String              @default("PENDING") // "PENDING" | "MANUAL_APPROVED" | "SUCCESSFUL"
  sessionVersion   Int                 @default(0)
  accountType      String              @default("STANDARD") // "STANDARD" (bireysel) | "STUDENT" | "CORPORATE"
  /// Kurumsal: organisation name and number of seats the subscription is priced for.
  organization     String?
  seats            Int?
  /// Last authenticated request; drives the admin's live-user count.
  lastSeenAt       DateTime?
  /// Encrypted JSON of UI preferences (panels, views, read notifications). Nothing is kept in the browser.
  preferences      String              @default("")
  /// Set once all of the user's existing rows were encrypted (see src/lib/dataCrypto.ts).
  dataEncryptedAt  DateTime?
  /// The login e-mail was confirmed with a code sent to it (src/lib/verification.ts).
  emailVerifiedAt  DateTime?
  /// İki adımlı doğrulama (TOTP, authenticator app). Secrets are encrypted with the user's key.
  twoFactorSecret     String?
  twoFactorPending    String?
  twoFactorEnabledAt  DateTime?
  /// Last accepted 30-second step, so a code cannot be replayed.
  twoFactorLastStep   Int?
  /// JSON array of HMACs of unused recovery codes.
  twoFactorRecovery   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  folders      Folder[]
  notes        Note[]
  scripts      Script[]
  tasks        Task[]
  events       CalendarEvent[]
  mediaItems   MediaItem[]
  transactions FinanceTransaction[]
  categories   FinanceCategory[]
  kanbanCards  KanbanCard[]
  customers    Customer[]
  orgMembers   OrgMember[]
  studentProfile StudentProfile?
  studentDocument StudentDocument?
  verificationCodes VerificationCode[]
  feedback     Feedback[]
  pushSubscriptions PushSubscription[]

  @@index([status, subscriptionType])
  @@index([status, subscriptionPlan])
  @@index([paymentStatus])
}

model Folder {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  iconName    String?  @default("Folder")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  folder     String   @default("genel")
  tags       String   @default("[]") // JSON string
  isFavorite Boolean  @default(false)
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Script {
  id              String   @id @default(cuid())
  userId          String
  title           String
  targetPlatform  String   @default("YouTube")
  status          String   @default("fikir")
  sections        String   @default("[]") // JSON string of ScriptSection[]
  speakingRateWPM Int      @default(130)
  linkedNoteId    String?
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id             String    @id @default(cuid())
  userId         String
  title          String
  description    String?
  completed      Boolean   @default(false)
  priority       String    @default("orta")
  /// Görev süresi aralığı: optional first day; dueDate is the last day.
  startDate      String?
  dueDate        String?
  linkedNoteId   String?
  linkedScriptId String?
  /// Display name of who added it (kurumsal: owner or member).
  createdBy      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalendarEvent {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  date            String
  time            String?
  durationMinutes Int      @default(30)
  eventType       String   @default("gorev")
  platform        String?
  linkedScriptId  String?
  linkedNoteId    String?
  linkedTaskId    String?
  status          String   @default("planlandi")
  checklist       String   @default("[]") // JSON string of EventChecklistItem[]
  createdBy       String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MediaItem {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  type           String   @default("image")
  url            String
  thumbnailUrl   String?
  linkedNoteId   String?
  linkedScriptId String?
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FinanceTransaction {
  id                 String   @id @default(cuid())
  userId             String
  title              String
  amount             Float
  type               String   @default("gelir")
  category           String
  date               String
  endDate            String?  // Mandatory end date for recurring income
  currency           String?  @default("TRY")
  originalAmount     Float?
  exchangeRate       Float?
  markupTRY          Float?
  effectiveRate      Float?
  description        String?
  linkedScriptId     String?
  isRecurring        Boolean  @default(false)
  recurringFrequency String?
  isConfirmed        Boolean  @default(false)
  dueDate            String?
  priority           String?  @default("orta")
  /// Kredi / borç: the amount is the outstanding balance.
  isDebt              Boolean  @default(false)
  monthlyInterestRate Float?
  minPaymentRate      Float?
  createdBy          String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
}

model FinanceCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("gelir")
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KanbanCard {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  projectType    String   @default("genel")
  columnId       String   @default("fikir")
  priority       String   @default("orta")
  dueDate        String?
  tags           String   @default("[]")
  linkedScriptId String?
  linkedNoteId   String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// University student details and the academic tracker data (schedule, attendance, grades).
model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  university   String
  /// Id from the university catalog (src/lib/universities.ts); null for a school typed by hand.
  universityId String?
  studentEmail String
  /// The student e-mail once confirmed with a code: the student can sign in with it as well.
  /// Unique across accounts (checked in src/lib/loginEmail.ts; an index keeps db push non-destructive).
  loginEmail   String?
  department   String
  classYear    Int      @default(1) // 0 = hazırlık
  studentNo    String?
  data         String   @default("{}") // JSON: AcademicData (see src/lib/academic/types.ts)
  /// Öğrencilik doğrulaması: "email" (code to the university address) or "document" (approved by an admin).
  verifiedAt   DateTime?
  verifyMethod String?
  /// Uploaded student certificate awaiting review: "pending" | "rejected".
  documentStatus String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loginEmail])
  @@index([universityId])
}

/// Admin-editable system defaults (see src/lib/systemSettings.ts). One row, key "system".
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Kurumsal: a person the corporate owner added. Members sign in with their personal code and work
/// in the owner's (shared) data space with the permissions the owner / managers gave them.
model OrgMember {
  id             String    @id @default(cuid())
  ownerId        String
  name           String
  /// HMAC-SHA256 of the personal corporate code; the code itself is only shown once.
  codeHash       String    @unique
  /// Last characters of the code, so the owner can tell codes apart.
  codeHint       String
  role           String    @default("MEMBER") // "MANAGER" | "MEMBER"
  /// JSON: module -> "none" | "view" | "edit" (see src/lib/corporate.ts)
  permissions    String    @default("{}")
  /// Encrypted JSON of the member's own UI preferences.
  preferences    String    @default("")
  sessionVersion Int       @default(0)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// Kurumsal › Müşteriler: monthly fee and commitment period; payments are tracked per month.
model Customer {
  id          String   @id @default(cuid())
  userId      String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  monthlyFee  Float    @default(0)
  /// Day of the month the payment is due (1-31; clamped to the month's length).
  paymentDay  Int      @default(1)
  startDate   String   // YYYY-MM-DD, commitment start
  endDate     String   // YYYY-MM-DD, commitment end
  /// JSON: [{ month: "YYYY-MM", paidAt: "YYYY-MM-DD", amount, by? }] — `by`: who recorded the payment
  payments    String   @default("[]")
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time codes sent by e-mail (account e-mail, e-mail change, student e-mail). Only an HMAC of
/// the code is stored; codes expire and allow a few attempts.
model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  purpose    String    // "email" | "email-change" | "student-email"
  /// Address the code was sent to (lower-case).
  target     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Öğrenci belgesi uploaded for manual verification (encrypted; deleted once reviewed).
model StudentDocument {
  id         String   @id @default(cuid())
  userId     String   @unique
  fileName   String
  mime       String
  /// Base64 of the file, encrypted with the user's key.
  data       String
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// İstek, öneri, hata bildirimi and requests that need an admin decision (account type change,
/// a student's academic calendar proposed for their university). Shown in Yönetici Paneli › Talepler.
model Feedback {
  id         String    @id @default(cuid())
  userId     String
  /// "istek" | "oneri" | "hata" | "hesap-gecis" | "takvim"
  kind       String
  /// Who wrote it: a corporate member writes in the owner's account (memberId set).
  authorName String
  memberId   String?
  subject    String
  /// Encrypted with the user's key.
  message    String
  /// Encrypted JSON for request kinds (e.g. the proposed calendar).
  payload    String?
  /// "yeni" | "inceleniyor" | "cozuldu" | "reddedildi"
  status     String    @default("yeni")
  adminNote  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/// Academic calendar of a university, published by an admin. Students of that university get the
/// dates (term start/end, exam weeks, holidays) in Ders Takibi automatically.
model UniversityCalendar {
  universityId String   @id
  /// JSON: SchoolTerm[] (see src/lib/universities.ts)
  terms        String
  sourceUrl    String?
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

/// Web Push: a phone / computer that receives notifications even while the app is closed.
/// `userId` is the account (kurumsal: the owner); `memberId` is set for a corporate member's device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  memberId  String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastOkAt  DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Reminders already pushed (e.g. "task overdue"), so each one is sent once.
model PushSent {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}
